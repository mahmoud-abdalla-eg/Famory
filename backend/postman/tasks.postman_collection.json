{
  "info": {
    "name": "Family Tasks API",
    "_postman_id": "d6b5a5f3-7d71-4a5d-8f5f-6d5f9a7d3c11",
    "description": "Postman collection for testing task create, list, update, and delete endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"familyId\": \"{{familyId}}\",\n  \"title\": \"Wash dishes\",\n  \"description\": \"Clean all dishes after dinner\",\n  \"assignedTo\": \"{{assignedTo}}\",\n  \"dueDate\": \"{{dueDate}}\",\n  \"status\": \"todo\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create task returns 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Task payload exists', function () {",
              "  pm.expect(json).to.have.property('task');",
              "  pm.expect(json.task).to.have.property('_id');",
              "});",
              "",
              "if (json && json.task && json.task._id) {",
              "  pm.environment.set('taskId', json.task._id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List Tasks By Family",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tasks/{{familyId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            "{{familyId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('List tasks returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Tasks array exists', function () {",
              "  pm.expect(json).to.have.property('tasks');",
              "  pm.expect(json.tasks).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Task",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Wash dishes and wipe counter\",\n  \"status\": \"in-progress\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            "{{taskId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Update task returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Updated task returned', function () {",
              "  pm.expect(json).to.have.property('task');",
              "  pm.expect(json.task.status).to.eql('in-progress');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Task",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            "{{taskId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Delete task returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Delete response confirms success', function () {",
              "  pm.expect(json.status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    }
    ,
    {
      "name": "Delete Task As Non Creator",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            "{{taskId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Non creator delete returns 403', function () {",
              "  pm.response.to.have.status(403);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Permission message is returned', function () {",
              "  pm.expect(json.status).to.eql('error');",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "familyId",
      "value": ""
    },
    {
      "key": "assignedTo",
      "value": ""
    },
    {
      "key": "memberToken",
      "value": ""
    },
    {
      "key": "dueDate",
      "value": "2026-04-23T10:00:00.000Z"
    },
    {
      "key": "taskId",
      "value": ""
    }
  ]
}
